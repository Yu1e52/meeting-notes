{
  "name": "meeting-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "语音转会议纪要：录音/上传 → 转写 → AI 结构化纪要",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "dev:exe": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --win portable",
    "predist:exe": "node scripts/prepack-dist.cjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "multer": "^2.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0"
  },
  "author": "portfolio",
  "main": "desktop/main.js",
  "build": {
    "appId": "com.portfolio.meetingnotes",
    "productName": "Meeting Notes",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "!server/data/**",
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "meeting-notes-portable.exe"
    },
    "afterPack": "desktop/after-pack.cjs",
    "electronDist": "node_modules/.electron-dist-clean"
  }
}
